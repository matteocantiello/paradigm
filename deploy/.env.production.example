# Paradigm production environment — copy to deploy/.env.production, fill in,
#   chmod 600 deploy/.env.production
# (.env.production is gitignored; this .example is the tracked template.)

# --- Secrets (required) ---
# production.yaml uses BOTH: Claude (writer + experimentalist) and Gemini (most
# agents, via Google's OpenAI-compatible endpoint). Both must be set.
ANTHROPIC_API_KEY=sk-ant-REPLACE
GEMINI_API_KEY=REPLACE

# Optional: TogetherAI (open models — Llama / Qwen / DeepSeek). Set this to make
# Together selectable in the per-agent model picker; unset → it's hidden there.
# TOGETHER_API_KEY=REPLACE

# Optional: OpenAI (GPT-5 / GPT-4.1 / o-series). Set this to make OpenAI selectable
# in the per-agent model picker; unset → it's hidden there.
# OPENAI_API_KEY=REPLACE

# --- Literature (recommended) ---
# Perplexity powers seed discovery (ON in production.yaml — bootstraps the
# literature) plus optional citation-grounding / novelty checks. Without it those
# features no-op cleanly, but you lose the foundational-paper bootstrap.
PERPLEXITY_API_KEY=REPLACE
#
# NASA ADS — THE literature source for ASTRONOMY/ASTROPHYSICS (indexes A&A, MNRAS,
# ApJ, ...). STRONGLY recommended for any astro work: WITHOUT it, journal papers not
# on arXiv are invisible and keyword searches fall back to the local corpus — exactly
# what starved a red-noise run (every search returned the same 2 papers). It is the
# highest-weighted provider for astro. Free token:
#   https://ui.adsabs.harvard.edu/user/settings/token
# Uncomment ONLY with a real token pasted in — a stray "REPLACE" value 401s, whereas
# leaving it unset degrades cleanly (fine for non-astro domains).
# NASA_ADS_API_KEY=...
#
# Optional extra sources / higher rate limits (all degrade gracefully if unset):
# SEMANTIC_SCHOLAR_API_KEY=...   # higher Semantic Scholar throughput
# SERPAPI_KEY=...                # enables the Google Scholar provider

# --- Runtime config ---
PARADIGM_CONFIG=configs/production.yaml
# Persistent, backed-up volume for SQLite + ChromaDB (NOT the repo checkout).
PARADIGM_DATA_DIR=/var/lib/paradigm/data
# Lock CORS to your public origin (the Caddy domain).
PARADIGM_CORS_ORIGINS=https://paradigm.example.com
# Bound simultaneous runs (CPU/RAM + token cost). Size to your VM.
PARADIGM_MAX_CONCURRENT_SESSIONS=3

# --- Optional defense-in-depth ---
# If set, the API also requires this key (X-API-Key). The Caddy basic-auth gate
# already covers the browser; only set this if you want a second layer, and note
# the frontend must then send the header.
# PARADIGM_API_KEY=REPLACE

# alphaXiv MCP: DISABLED by default (literature.mcp.enabled: false) — the OAuth
# token expires and can't re-auth headless. To use it, set that flag true and copy
# the cached token dir to the VM: scp -r ~/.paradigm/mcp/ root@vm:/root/.paradigm/
