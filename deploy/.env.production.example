# Paradigm production environment — copy to deploy/.env.production, fill in,
#   chmod 600 deploy/.env.production
# (.env.production is gitignored; this .example is the tracked template.)

# --- Secrets (required) ---
ANTHROPIC_API_KEY=sk-ant-REPLACE
TOGETHER_API_KEY=REPLACE
# PERPLEXITY_API_KEY=...        # only if citation grounding is enabled

# --- Runtime config ---
PARADIGM_CONFIG=configs/production.yaml
# Persistent, backed-up volume for SQLite + ChromaDB (NOT the repo checkout).
PARADIGM_DATA_DIR=/var/lib/paradigm/data
# Lock CORS to your public origin (the Caddy domain).
PARADIGM_CORS_ORIGINS=https://paradigm.example.com
# Bound simultaneous runs (CPU/RAM + token cost). Size to your VM.
PARADIGM_MAX_CONCURRENT_SESSIONS=3

# --- Optional defense-in-depth ---
# If set, the API also requires this key (X-API-Key). The Caddy basic-auth gate
# already covers the browser; only set this if you want a second layer, and note
# the frontend must then send the header.
# PARADIGM_API_KEY=REPLACE

# alphaXiv MCP: no key here — copy the cached OAuth token dir to the VM instead:
#   scp -r ~/.paradigm/mcp/ paradigm@vm:~/.paradigm/   (see DEPLOY.md)
