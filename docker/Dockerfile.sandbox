FROM python:3.12-slim

# Install scientific Python packages
RUN pip install --no-cache-dir \
    numpy \
    scipy \
    matplotlib \
    pandas \
    scikit-learn \
    sympy \
    astropy \
    requests \
    pypdf \
    h5py \
    seaborn \
    emcee \
    corner \
    lmfit \
    uncertainties \
    statsmodels \
    tqdm \
    numba \
    xarray \
    pyyaml \
    joblib

# Create non-root user
RUN useradd --create-home --shell /bin/bash sandbox

# Create data directories
RUN mkdir -p /data/results /data/shared /data/workspace && \
    chown -R sandbox:sandbox /data

# Switch to non-root user
USER sandbox
WORKDIR /data/results
