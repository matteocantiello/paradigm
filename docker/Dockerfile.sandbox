FROM python:3.12-slim

# Install scientific Python packages
RUN pip install --no-cache-dir \
    numpy \
    scipy \
    matplotlib \
    pandas \
    scikit-learn \
    sympy \
    astropy \
    requests \
    pypdf \
    pdfminer.six \
    beautifulsoup4 \
    h5py \
    seaborn \
    emcee \
    corner \
    lmfit \
    uncertainties \
    statsmodels \
    tqdm \
    numba \
    xarray \
    pyyaml \
    joblib

# Extra packages PROMISED to agents in the EXECUTION prompt (orchestrator/constants.py).
# Keep this list in sync with that prompt's "Extra packages" line — otherwise agents
# import something that isn't here and hand-roll broken substitutes (we saw
# dust_extinction -> a buggy inline CCM89). All ship cp312 linux wheels, so the
# slim base needs no compiler.
RUN pip install --no-cache-dir \
    photutils \
    specutils \
    dust_extinction \
    plotly \
    bokeh \
    tables \
    netCDF4 \
    pyarrow

# Create non-root user
RUN useradd --create-home --shell /bin/bash sandbox

# Create data directories
RUN mkdir -p /data/results /data/shared /data/workspace && \
    chown -R sandbox:sandbox /data

# Switch to non-root user
USER sandbox
WORKDIR /data/results
