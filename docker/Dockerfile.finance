# Finance sandbox Dockerfile
# Extends the base paradigm sandbox with econometrics and quant finance packages

FROM python:3.12-slim

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gfortran \
    libopenblas-dev \
    && rm -rf /var/lib/apt/lists/*

# Core scientific packages
RUN pip install --no-cache-dir \
    numpy \
    scipy \
    matplotlib \
    pandas \
    scikit-learn \
    sympy \
    seaborn \
    tqdm \
    numba \
    joblib \
    pyyaml

# Econometrics packages
RUN pip install --no-cache-dir \
    statsmodels \
    linearmodels \
    arch

# Quant finance packages
RUN pip install --no-cache-dir \
    quantlib-python \
    pyfolio-reloaded \
    zipline-reloaded

# Financial data access (for offline cached data)
RUN pip install --no-cache-dir \
    fredapi \
    pandas-datareader \
    yfinance

# Utility packages
RUN pip install --no-cache-dir \
    pypdf \
    pdfminer.six \
    beautifulsoup4 \
    h5py \
    xarray \
    uncertainties \
    lmfit

# Create workspace directories
RUN mkdir -p /data/shared /data/workspace /data/packages

# Security: run as non-root
RUN useradd -m sandbox
USER sandbox
WORKDIR /home/sandbox

# Default command
CMD ["python3"]
